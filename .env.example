# Local controller. Copy to .env; .env remains ignored.
SATQUERY_ENVIRONMENT=development
SATQUERY_MODEL_BACKEND=http
# The two mandatory pair workflows run as bounded local CPU tools by default.
# Set to http only after trained change/fusion services pass their release gates.
SATQUERY_PAIR_BACKEND=local
SATQUERY_MODEL_SERVICE_URL=https://YOUR-NGROK-DEV-DOMAIN.ngrok-free.app
SATQUERY_MODEL_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_32_PLUS_CHARACTER_KAGGLE_SECRET
# Leave blank for local development. Set a long random value only for a network deployment.
SATQUERY_API_KEY=
SATQUERY_ALLOWED_ORIGINS=http://localhost:3000
SATQUERY_ENABLE_DOCS=true
SATQUERY_MAX_UPLOAD_BYTES=52428800
SATQUERY_JOB_TIMEOUT_SECONDS=600
SATQUERY_MODEL_TIMEOUT_SECONDS=300

# For a model service running on this computer instead:
# SATQUERY_MODEL_SERVICE_URL=http://127.0.0.1:8080

# Local/demo API. Copy to .env and replace placeholders; .env remains ignored.
SATQUERY_ENVIRONMENT=development
SATQUERY_MODEL_BACKEND=space
SATQUERY_SPACE_URL=https://aanandmodi-satquery-qwen3vl-space.hf.space
# Optional for a public Space. If set, keep this server-side only.
SATQUERY_SPACE_TOKEN=
SATQUERY_API_KEY=replace-with-a-long-random-value
SATQUERY_ALLOWED_ORIGINS=http://localhost:3000
SATQUERY_ENABLE_DOCS=true
SATQUERY_MAX_UPLOAD_BYTES=52428800
SATQUERY_JOB_TIMEOUT_SECONDS=600

